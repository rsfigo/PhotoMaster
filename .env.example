# KI-Funktionen (optional). Ohne Schlüssel funktionieren manuelle Bearbeitung
# und Export vollständig; nur die KI-Knöpfe melden sich als nicht eingerichtet.
ANTHROPIC_API_KEY=

# Modell und Serverport lassen sich überschreiben:
# PM_AI_MODEL=claude-opus-5-5
# PM_PORT=5174
# PM_DATA_DIR=D:\PhotoMaster\data

# Abweichender Endpunkt, etwa ein Firmen-Proxy vor der Anthropic-API:
# ANTHROPIC_BASE_URL=https://proxy.example.com

# Wie lange auf den BEGINN einer KI-Antwort gewartet wird, in Millisekunden.
# Die Antwort wird gestreamt; ausführliches Nachdenken darf länger dauern.
# PM_AI_TIMEOUT_MS=90000
